{
  "name": "colegio-la-pulida-api",
  "version": "1.0.0",
  "private": true,
  "description": "API para la gestión de llegadas tardías de estudiantes de Colegio La Pulida S.A.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -k -n API,FrontEnd -c green,cyan \"npm run dev:api\" \"npm run dev:frontend\"",
    "dev:api": "node --watch src/server.js",
    "dev:frontend": "npm run dev --prefix FrontEnd",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "prisma": "^6.19.3"
  }
}
