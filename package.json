{
  "name": "api-express",
  "version": "1.0.0",
  "private": true,
  "main": "src/app.js",
  "scripts": {
    "dev": "concurrently -k -n API,FrontEnd -c green,cyan \"npm run start\" \"npm run dev --prefix FrontEnd\"",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prisma": "^6.19.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
